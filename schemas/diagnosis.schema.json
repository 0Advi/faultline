{
  "$defs": {
    "DiagnosisCategory": {
      "enum": [
        "healthy",
        "card_decline",
        "handler_failure",
        "connectivity",
        "currency_conversion",
        "amount_validation",
        "duplicate_payment_risk",
        "unknown_outcome",
        "post_payment_failure",
        "insufficient_evidence"
      ],
      "title": "DiagnosisCategory",
      "type": "string"
    }
  },
  "$id": "faultline/diagnosis/1.0.0",
  "additionalProperties": false,
  "properties": {
    "affected_paths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Affected Paths",
      "type": "array"
    },
    "alternatives": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "category": {
      "$ref": "#/$defs/DiagnosisCategory"
    },
    "cited_observations": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
        "type": "string"
      },
      "title": "Cited Observations",
      "type": "array"
    },
    "edge": {
      "anyOf": [
        {
          "pattern": "^[a-z-]+->[a-z-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Edge"
    },
    "next_action": {
      "title": "Next Action",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "enum": [
        "1.0.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "service": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Service"
    },
    "uncertainty": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Uncertainty",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "category",
    "uncertainty",
    "next_action"
  ],
  "title": "Diagnosis",
  "type": "object"
}
