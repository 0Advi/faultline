{
  "$defs": {
    "RunState": {
      "enum": [
        "DRAFT",
        "BASELINING",
        "READY",
        "ARMED",
        "RUNNING",
        "RESTORING",
        "VERIFYING_RECOVERY",
        "RECOVERED",
        "ABORTED",
        "FAILED",
        "NEEDS_ATTENTION"
      ],
      "title": "RunState",
      "type": "string"
    },
    "StopReason": {
      "enum": [
        "completed",
        "manual_abort",
        "deadline",
        "protected_path_degraded",
        "observation_loss",
        "config_conflict",
        "adapter_error",
        "controller_lost",
        "precondition_failed"
      ],
      "title": "StopReason",
      "type": "string"
    }
  },
  "$id": "faultline/event/1.0.0",
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "data": {
      "default": {},
      "title": "Data",
      "type": "object"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "enum": [
        "1.0.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/RunState"
    },
    "stop_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/StopReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "type": {
      "enum": [
        "state_changed",
        "action_applied",
        "action_restored",
        "observation",
        "warning",
        "error",
        "note"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "seq",
    "at",
    "type",
    "state"
  ],
  "title": "Event",
  "type": "object"
}
