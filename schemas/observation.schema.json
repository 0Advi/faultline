{
  "$id": "faultline/observation/1.0.0",
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "cart_retained": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cart Retained"
    },
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "expected_outcome_met": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Outcome Met"
    },
    "fresh": {
      "title": "Fresh",
      "type": "boolean"
    },
    "http_status": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Http Status"
    },
    "latency_ms": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Ms"
    },
    "log_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Log Refs",
      "type": "array"
    },
    "metric_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Metric Refs",
      "type": "array"
    },
    "missing": {
      "description": "Signals that were expected but not observed; never filled in by inference.",
      "items": {
        "type": "string"
      },
      "title": "Missing",
      "type": "array"
    },
    "observation_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "title": "Observation Id",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "success",
        "http_error",
        "rpc_error",
        "timeout",
        "not_observed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "phase": {
      "enum": [
        "warmup",
        "baseline",
        "fault",
        "recovery",
        "control"
      ],
      "title": "Phase",
      "type": "string"
    },
    "probe": {
      "title": "Probe",
      "type": "string"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "rpc_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rpc Code"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "enum": [
        "1.0.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "services": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Services",
      "type": "array"
    },
    "span_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Span Ids",
      "type": "array"
    },
    "trace_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "transaction_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Transaction Ids",
      "type": "array"
    }
  },
  "required": [
    "observation_id",
    "run_id",
    "at",
    "probe",
    "phase",
    "outcome",
    "fresh",
    "complete"
  ],
  "title": "Observation",
  "type": "object"
}
