{
  "$defs": {
    "Revisions": {
      "additionalProperties": false,
      "properties": {
        "config_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Sha256"
        },
        "images": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Images",
          "type": "object"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "workload_version": {
          "title": "Workload Version",
          "type": "string"
        }
      },
      "required": [
        "source",
        "workload_version"
      ],
      "title": "Revisions",
      "type": "object"
    },
    "RunState": {
      "enum": [
        "DRAFT",
        "BASELINING",
        "READY",
        "ARMED",
        "RUNNING",
        "RESTORING",
        "VERIFYING_RECOVERY",
        "RECOVERED",
        "ABORTED",
        "FAILED",
        "NEEDS_ATTENTION"
      ],
      "title": "RunState",
      "type": "string"
    },
    "StopReason": {
      "enum": [
        "completed",
        "manual_abort",
        "deadline",
        "protected_path_degraded",
        "observation_loss",
        "config_conflict",
        "adapter_error",
        "controller_lost",
        "precondition_failed"
      ],
      "title": "StopReason",
      "type": "string"
    }
  },
  "$id": "faultline/run/1.0.0",
  "additionalProperties": false,
  "properties": {
    "applied_state": {
      "default": {},
      "title": "Applied State",
      "type": "object"
    },
    "cleanup_verified": {
      "default": false,
      "title": "Cleanup Verified",
      "type": "boolean"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "last_event_seq": {
      "default": 0,
      "minimum": 0,
      "title": "Last Event Seq",
      "type": "integer"
    },
    "plan_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "title": "Plan Id",
      "type": "string"
    },
    "prior_state": {
      "default": {},
      "title": "Prior State",
      "type": "object"
    },
    "recovery_outcome": {
      "anyOf": [
        {
          "enum": [
            "verified",
            "unverified",
            "failed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recovery Outcome"
    },
    "restored_state": {
      "default": {},
      "title": "Restored State",
      "type": "object"
    },
    "revisions": {
      "$ref": "#/$defs/Revisions"
    },
    "run_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "enum": [
        "1.0.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "state": {
      "$ref": "#/$defs/RunState"
    },
    "stop_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/StopReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "plan_id",
    "state",
    "revisions"
  ],
  "title": "Run",
  "type": "object"
}
